executable = mbd_vertex_eff_syst.sh
arguments = $(sim) $(runnumber) $(bkg_cut) $(vz1) $(trig) $(start_seg) $(end_seg)
output = output_logs/output_$(Process).out
when_to_transfer_output = ON_EXIT
error			= output_logs/error_$(Process).err
log = /tmp/egm2153_$(Process).log
queue sim, runnumber, bkg_cut, vz1, trig, start_seg, end_seg from mbd_vertex_eff_syst_queue.list
