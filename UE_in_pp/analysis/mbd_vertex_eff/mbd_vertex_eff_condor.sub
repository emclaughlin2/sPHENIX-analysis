executable = mbd_vertex_eff_sim.sh
arguments = $(trig) $(start_seg) $(end_seg) $(bkg_cut) $(vz1) $(vz2)
output = output_logs/output_$(Process).out
when_to_transfer_output = ON_EXIT
error			= output_logs/error_$(Process).err
log = /tmp/egm2153_$(Process).log
queue trig, start_seg, end_seg, bkg_cut, vz1, vz2 from mbd_vertex_eff_sim_queue.list
